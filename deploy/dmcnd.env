# /etc/dmcnd/dmcnd.env: per-host settings for the dmcnd service.
#
# systemd reads this file itself, so it takes plain KEY=value lines: no `export`, no shell
# expansion, no command substitution. Moving settings over from a shell profile means dropping
# the `export ` prefix from each line.
#
# DMCND_DATA_DIR is set in the unit (/var/lib/dmcnd) and the identity key lives there as node.key.
# Files you hand the daemon (bridge credential, DKIM key, TLS cert) go in /etc/dmcnd, owned
# root:dmcnd and mode 0640, so the daemon can read them and cannot change them.
#
# After editing:  sudo systemctl restart dmcnd

# --- Domain -------------------------------------------------------------------------------------

# The domain addresses belong to (user@<domain>).
DMCND_DOMAIN=mesh.example
# Hostname webmail is served and certificated on, when it is not the domain itself: addresses
# stay user@mesh.example while webmail lives at mail.mesh.example. Needs its own A/AAAA record.
#DMCND_WEB_HOST=mail.mesh.example

# --- Listeners ----------------------------------------------------------------------------------

# Webmail. Defaults to :443, the only port autocert's ACME challenge works on.
#DMCND_LISTEN=:443
# libp2p. This port is in your published seed= multiaddr, so keep it stable.
#DMCND_NODE_LISTEN=/ip4/0.0.0.0/tcp/7400
# Multiaddr(s) other domains should reach this node at, when the bound address is not the
# reachable one (a NAT'd cloud VM). Replaces detection.
#DMCND_ANNOUNCE_ADDR=/ip4/203.0.113.10/tcp/7400

# --- TLS ----------------------------------------------------------------------------------------

# Leave both unset to use autocert (certificates cached in /var/lib/dmcnd/certs).
#DMCND_TLS_CERT=/etc/dmcnd/tls.crt
#DMCND_TLS_KEY=/etc/dmcnd/tls.key

# --- Federation ---------------------------------------------------------------------------------

# Bootstrap/discovery peer multiaddrs (comma-separated). Where to dial, never a trust list.
#DMCND_PEERS=
# Static allow-list of peers (base58 IDs or multiaddrs) admitted alongside credential-based
# trust. Empty means deny-by-default for the static list; a single * admits everyone.
#DMCND_ALLOWED_PEERS=
# Static _dmcn pins for peer domains, for DNS-free federation. Path to a file.
#DMCND_STATIC_DNS=/etc/dmcnd/static-dns

# --- Mail handling ------------------------------------------------------------------------------

# How long an unclaimed mailbox petition survives.
#DMCND_PETITION_TTL=24h
# How long undelivered mail waits in the in-flight queue (and the bridge retries outbound).
#DMCND_TRANSIT_MAX_AGE=120h
# Webmail mailbox poll cadence.
#DMCND_POLL_INTERVAL=10s

# --- SMTP bridge (optional) ---------------------------------------------------------------------
# Delete this section if the domain does not exchange mail with ordinary email.

#DMCND_BRIDGE_ENABLED=true
# The root-signed `bridge` credential (`dmcndcli bridge issue`, run on your admin machine).
#DMCND_BRIDGE_CREDENTIAL=/etc/dmcnd/bridge.cred
# smtp = real MX lookup + STARTTLS. The default, stub, sends nothing.
#DMCND_BRIDGE_DELIVERY_MODE=smtp
# dns = real SPF/DKIM/DMARC on inbound mail. stub is for offline dev only.
#DMCND_BRIDGE_AUTH_MODE=dns
# Outbound DKIM key (`dmcndcli bridge dkim-keygen`). Without it outbound mail is unsigned.
#DMCND_BRIDGE_DKIM_KEY=/etc/dmcnd/dkim.pem
#DMCND_BRIDGE_DKIM_SELECTOR=dmcn
# Defaults to DMCND_DOMAIN. Set only if the legacy email domain differs.
#DMCND_BRIDGE_DOMAIN=
# EHLO name; must match the sending IP's PTR. Defaults to DMCND_WEB_HOST, else the domain.
#DMCND_BRIDGE_HELO=mail.mesh.example
# Public addresses this host sends from, so the DNS records printed at startup are pasteable.
#DMCND_BRIDGE_SEND_IPS=203.0.113.10,2001:db8::10
# Defaults to :25.
#DMCND_BRIDGE_SMTP_LISTEN=:25
# Append-only, hash-chained audit log of every bridge decision. Keep it on.
#DMCND_BRIDGE_AUDIT_LOG=/var/lib/dmcnd/bridge-audit.jsonl

# --- Rarely needed ------------------------------------------------------------------------------

# Identity key path. Defaults to /var/lib/dmcnd/node.key; only change it if you know why.
#DMCND_IDENTITY=/var/lib/dmcnd/node.key

# Dev mode and its seed passphrase are for a laptop, never for a service: dev serves plain HTTP
# and stubs DNS anchoring. They are listed so nothing the daemon reads goes undocumented.
#DMCND_DEV=false
#DMCND_SEED_PASSPHRASE=
